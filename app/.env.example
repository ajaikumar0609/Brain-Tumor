# Copy to app/.env if you need to change anything. No secrets are used by this app.
# Backend (read from the environment when uvicorn starts)
NEUROVISION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NEUROVISION_MAX_UPLOAD_MB=10
# Optional overrides (defaults are paths relative to the project root)
# NEUROVISION_PROJECT_ROOT=
# NEUROVISION_GENERATOR_CKPT=
# NEUROVISION_CLASSIFIER_CKPT=
# Frontend (Vite)
# VITE_API_PROXY=http://127.0.0.1:8000
# VITE_API_BASE=
